# Backend environment variables example
# Copy this file to .env and fill in your values

# ──────────────────────────────────────
# Application
# ──────────────────────────────────────
APP_NAME="AI Site Studio"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development   # development | staging | production
TEMPLATE_DOWNLOADS_FREE=True  # Temporarily make all published marketplace templates free

# ──────────────────────────────────────
# Database (PostgreSQL / Supabase)
# ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Separate database for generated-shop customer accounts, products, and orders.
# Point this at a different database; leave empty to keep shop checkout disabled.
COMMERCE_DATABASE_URL=

# Store order notifications (credentials stay server-side; owners configure per-store destinations in Dashboard)
# Email uses Resend when RESEND_API_KEY is set, otherwise SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ENABLE_EMAIL_DELIVERY=true
RESEND_API_KEY=
RESEND_FROM="Site Studio <onboarding@resend.dev>"
# SMS uses Twilio. Use a verified sender/number accepted by your Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ──────────────────────────────────────
# Redis
# ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────
# Security
# ──────────────────────────────────────
SECRET_KEY=generate_a_random_32_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30

# ──────────────────────────────────────
# OAuth (Google / Facebook / GitHub)
# ──────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ──────────────────────────────────────
# AI Providers (OpenAI / Gemini)
# ──────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=your-gemini-api-key
# Optional: comma-separated extra Gemini keys, rotated on each request.
GEMINI_API_KEYS=
AI_GEMINI_TIMEOUT_SECONDS=600
GEMINI_MODEL=gemini-3.6-flash

# Separate Gemini models per feature
GEMINI_MODEL_AI_CHAT_ASSISTANT=gemini-3.8-flash
GEMINI_MODEL_WEBSITE_CONTENT_GENERATION=gemini-3.8-flash
GEMINI_MODEL_SEO_GENERATOR=gemini-3.8-flash
GEMINI_MODEL_SEMANTIC_SEARCH=gemini-embedding-2
GEMINI_MODEL_TEMPLATE_RECOMMENDATION=gemini-embedding-2
GEMINI_MODEL_ACCESSIBILITY_REVIEW=gemini-3.8-flash
GEMINI_MODEL_CODE_ASSISTANT=gemini-3.8-flash
GEMINI_MODEL_PROJECT_ZIP_ANALYSIS=gemini-3.8-flash
GEMINI_MODEL_TRANSLATION=gemini-3.8-flash
GEMINI_MODEL_BUSINESS_ANALYSIS=gemini-3.8-flash
GEMINI_MODEL_LOGO_IDEAS=gemini-3.8-flash
GEMINI_MODEL_IMAGE_GENERATION=flux
GEMINI_MODEL_OCR_DOCUMENT_UNDERSTANDING=gemini-3.5-flash

# Alternative models per feature
ALT_MODEL_AI_CHAT_ASSISTANT=gpt-4o-mini
ALT_MODEL_WEBSITE_CONTENT_GENERATION=gpt-4o-mini
ALT_MODEL_SEO_GENERATOR=gpt-4o-mini
ALT_MODEL_SEMANTIC_SEARCH=cohere-embed
ALT_MODEL_TEMPLATE_RECOMMENDATION=cohere-embed
ALT_MODEL_ACCESSIBILITY_REVIEW=gpt-4o
ALT_MODEL_CODE_ASSISTANT=gpt-4.1
ALT_MODEL_PROJECT_ZIP_ANALYSIS=gpt-4.1
ALT_MODEL_TRANSLATION=gpt-4o-mini
ALT_MODEL_BUSINESS_ANALYSIS=gpt-4o
ALT_MODEL_LOGO_IDEAS=gpt-4o
ALT_MODEL_IMAGE_GENERATION=stable-diffusion-xl
ALT_MODEL_OCR_DOCUMENT_UNDERSTANDING=gpt-4o

# ── Azure OpenAI (Fallback / Alternate) ──
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional deployment mappings (fallbacks if blank)
AZURE_DEPLOYMENT_CHAT=
AZURE_DEPLOYMENT_AI_CHAT_ASSISTANT=
AZURE_DEPLOYMENT_WEBSITE_CONTENT_GENERATION=
AZURE_DEPLOYMENT_SEO_GENERATOR=
AZURE_DEPLOYMENT_SEMANTIC_SEARCH=
AZURE_DEPLOYMENT_TEMPLATE_RECOMMENDATION=
AZURE_DEPLOYMENT_ACCESSIBILITY_REVIEW=
AZURE_DEPLOYMENT_CODE_ASSISTANT=
AZURE_DEPLOYMENT_PROJECT_ZIP_ANALYSIS=
AZURE_DEPLOYMENT_TRANSLATION=
AZURE_DEPLOYMENT_BUSINESS_ANALYSIS=
AZURE_DEPLOYMENT_LOGO_IDEAS=
AZURE_DEPLOYMENT_IMAGE_GENERATION=
AZURE_DEPLOYMENT_OCR_DOCUMENT_UNDERSTANDING=

# ──────────────────────────────────────
# Qdrant Vector Database
# ──────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=templates

# ──────────────────────────────────────
# File Storage (PostgreSQL / R2)
# ──────────────────────────────────────
STORAGE_BACKEND=postgres
STORAGE_BASE_URL=http://localhost:8000/api/v1/files

# ──────────────────────────────────────
# Cloudflare R2 Storage (Optional)
# ──────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ai-site-studio
# R2_PUBLIC_URL=

# ──────────────────────────────────────
# Payments (Razorpay / Stripe)
# ──────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_HOSTING_PRICE_ID=  # Recurring monthly Stripe Price for managed static hosting
HOSTING_GRACE_PERIOD_DAYS=3  # Days after a failed hosting renewal before cancellation/suspension

# Direct UPI Payment (QR Code)
UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME="AI Site Studio"

# ──────────────────────────────────────
# CORS & Domains
# ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────
# File Upload Limits
# ──────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
PIXABAY_API_KEY=  # Optional: automatically source and cache licensed stock photos when a Studio project has no uploaded images

# ──────────────────────────────────────
# Multi-Tenant Deployment Infrastructure
# ──────────────────────────────────────
PLATFORM_DOMAIN=aisitestudio.com
DEPLOYMENT_BASE_DOMAIN=aisitestudio.com
DEPLOYMENT_PROVIDER=local   # local | docker | cloud
LOCAL_DEPLOYMENT_ENABLED=false  # Allow builds on the backend host only when explicitly trusted
DEPLOYMENT_STORAGE_PATH=static/deployments
DEPLOYMENT_HOST_IP=  # Public IPv4 address for GoDaddy DNS A records
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GODADDY_PAT=  # Server-only PAT: domain read/create/update, contact update, and DNS update scopes
GODADDY_API_BASE_URL=https://api.godaddy.com
CUSTOM_DOMAIN_TLS_ENABLED=false  # Set true only behind the included Caddy reverse proxy or equivalent TLS service

# ──────────────────────────────────────
# AI provider behavior (including local inference through Ollama)
# AI_PROVIDER_FALLBACKS=false prevents an explicitly selected provider from
# silently switching to another hosted provider. Set AI_FREE_ONLY=true to block
# every hosted provider, including explicitly selected Gemini calls.
# ──────────────────────────────────────
AI_FREE_ONLY=false
AI_PROVIDER_FALLBACKS=false
AI_LOCAL_FALLBACKS=true
AI_WEBSITE_PROVIDER_ORDER=groq,ollama
WEBSITE_PAGE_GENERATION_CONCURRENCY=3
AI_PRIMARY_PROVIDER=ollama
AGENT_PLANNING_PROVIDER=groq
AGENT_DESIGNER_PROVIDER=groq
AGENT_FRONTEND_PROVIDER=groq
AGENT_BACKEND_PROVIDER=cline
AGENT_DATABASE_PROVIDER=cline
AGENT_SEO_PROVIDER=ollama
AGENT_TESTING_PROVIDER=cline
AGENT_DEPLOYMENT_PROVIDER=cline
AGENT_CODE_DEBUGGING_AGENT_PROVIDER=ollama
AGENT_CODE_ASSISTANT_PROVIDER=groq
AGENT_WEBSITE_CONTENT_GENERATION_PROVIDER=groq

# Studio analysis and prompt planning use Groq, then Ollama/Cline fallback.
# Studio page code uses local Cline-compatible Ollama, then Ollama fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434/v1
# Output budget only; the model's input context window is set separately in its Ollama Modelfile (num_ctx).
OLLAMA_MAX_OUTPUT_TOKENS=8192
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODEL_FALLBACK=qwen2.5:latest
OLLAMA_MODEL_PLANNING=qwen3.5:9b
OLLAMA_MODEL_PLANNING_FALLBACK=qwen2.5:latest
OLLAMA_MODEL_DESIGNER=qwen3.5:9b
OLLAMA_MODEL_DESIGNER_FALLBACK=qwen2.5:latest
OLLAMA_MODEL_SEO=qwen3.5:9b
OLLAMA_MODEL_SEO_FALLBACK=qwen2.5:latest
OLLAMA_MODEL_CODE=qwen3.5:9b,qwen2.5-coder:7b
OLLAMA_MODEL_CODE_FALLBACK=qwen2.5:latest

# Backend, test, and release-review agents use the code model above automatically.
# They add advisory reviews around deterministic scaffold/build/link/package checks;
# the model never overrides a failed deterministic validation or rewrites the ZIP.
# Ollama must be running and both model tags must be pulled on the machine running
# the backend. Hosted deployment requires a reachable Ollama host or a configured
# hosted provider; local models are not bundled into generated site ZIPs.

# Gemini is selected for planning and website content; other agents use local Ollama/Cline.
# Use a Gemini API key on its free tier to avoid charges. Free quotas/rate limits still apply;
# on quota or API failure the configured local Ollama model is used. Set AI_FREE_ONLY=true
# to force every generation request to stay local (this also disables Gemini calls).


