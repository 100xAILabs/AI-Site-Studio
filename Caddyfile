{
	on_demand_tls {
		ask http://api:8000/internal/tls-authorize
	}
}

http:// {
	redir https://{host}{uri} permanent
}

https:// {
	tls {
		on_demand
	}

	# Block external internet access to internal service endpoints
	@internal path /internal/*
	handle @internal {
		respond "Access Denied" 403
	}

	reverse_proxy api:8000
}
